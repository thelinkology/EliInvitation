# ---------------------------------------------------------------------------
# Copy this file to `.env.local` for local testing, and add the same names in
# Vercel → Project → Settings → Environment Variables for the live site.
# None of these may start with NEXT_PUBLIC_ — they must stay on the server.
# See docs/SETUP.md for where each value comes from.
# ---------------------------------------------------------------------------

# Your live site address (used for link previews). Optional on Vercel.
SITE_URL=

# --- Custom RSVP (recommended): Google Apps Script web app + Google Sheet ---
# Apps Script → Deploy → Manage deployments → Web app URL (ends in /exec)
APPS_SCRIPT_URL=
# Sheet menu: Invitation → Show website secret
APPS_SCRIPT_SECRET=

# --- Google Forms fallback (used when the two values above are empty, or if
#     the Sheet can't be reached). Paste the full "Send → link" responder URL,
#     e.g. https://docs.google.com/forms/d/e/XXXXXXXX/viewform
GOOGLE_FORM_GUEST_URL=
GOOGLE_FORM_GODPARENT_URL=
# Optional: only if godparents RSVP for attendance on a separate form.
GOOGLE_FORM_GODPARENT_ATTENDANCE_URL=

# Optional: prefill the guest's name. Use the entry id from a prefilled link,
# e.g. entry.1234567890 (see docs/SETUP.md, Part C).
GOOGLE_FORM_GUEST_NAME_ENTRY=
GOOGLE_FORM_GODPARENT_NAME_ENTRY=
GOOGLE_FORM_GODPARENT_ATTENDANCE_NAME_ENTRY=
